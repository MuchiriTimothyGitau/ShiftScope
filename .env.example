# Google Gemini API key (for AI analysis chain)
GEMINI_API_KEY=your-gemini-api-key

# Redis (for BullMQ — local or Upstash)
REDIS_URL=redis://localhost:6379

# Supabase (optional — for persisting results to database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Bright Data credentials (for web scraping)
BRIGHT_DATA_USERNAME=your-bd-username
BRIGHT_DATA_PASSWORD=your-bd-password
BD_SCRAPING_BROWSER_WS=wss://brd.superproxy.io:9222
BD_UNLOCKER_HOST=brd.superproxy.io
BD_UNLOCKER_PORT=22225
BD_SERP_URL=https://api.brightdata.com/datasets/v3/query
BD_SERP_API_KEY=your-serp-api-key
BD_DATASET_API_KEY=your-dataset-api-key
BD_DATASET_NPM_ID=gd_npm_packages_v3
BD_DATASET_PYPI_ID=gd_pypi_packages_v2

# Delivery services (for alerts)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=your-slack-channel-id
RESEND_API_KEY=your-resend-api-key
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_URL=your-webhook-url
ALERT_EMAIL_TO=team@example.com

# Configuration
SCAN_INTERVAL_MINUTES=15
REGISTRY_CHECK_TIMEOUT_MS=5000
MAX_CONCURRENT_SCRAPES=20
LOG_LEVEL=info
